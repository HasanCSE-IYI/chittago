<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="12dp">

    <!-- Icon -->
    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_chip_selected">

        <ImageView
            android:id="@+id/ivEmergencyIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_emergency"
            app:tint="@color/surface_white" />
    </FrameLayout>

    <!-- Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvEmergencyName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="জাতীয় জরুরি সেবা (৯৯৯)"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEmergencySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="পুলিশ, অ্যাম্বুলেন্স ও ফায়ার সার্ভিস"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Call Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEmergencyCall"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:backgroundTint="@color/emerald"
        android:text="কল করুন"
        android:textAllCaps="false"
        android:textColor="@color/surface_white"
        android:textSize="12sp"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_call"
        app:iconGravity="textStart"
        app:iconSize="16dp"
        app:iconTint="@color/surface_white" />
</LinearLayout>
